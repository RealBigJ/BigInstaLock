<Window
    x:Class="Valorant_Instalocker.CustomMessageBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Confirmation"
    Width="410"
    Height="210"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="1" CornerRadius="12">
        <Grid Margin="22" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,12,0,18" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="90" Margin="0,0,8,0" Click="No_Click" Content="Cancel" Style="{StaticResource SecondaryButton}" />
                <Button MinWidth="90" Click="Yes_Click" Content="Confirm" Style="{StaticResource ModernButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
