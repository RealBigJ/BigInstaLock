<Window
    x:Class="Valorant_Instalocker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Big Instalock"
    Width="1140"
    Height="760"
    MinWidth="980"
    MinHeight="660"
    Background="{DynamicResource AppBackground}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="1" CornerRadius="12">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Margin="16,0,10,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Image Width="31" Height="31" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/branding/big-instalock.png" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="BIG INSTALOCK" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="BtnNavDashboard" Click="SwitchTab_Click" Content="{DynamicResource HomeTab}" Style="{StaticResource TabButton}" />
                    <Button x:Name="BtnNavMacros" Click="SwitchTab_Click" Content="{DynamicResource MacrosTab}" Style="{StaticResource TabButton}" />
                    <Button x:Name="BtnNavSettings" Click="SwitchTab_Click" Content="{DynamicResource SettingsTab}" Style="{StaticResource TabButton}" />
                    <Button x:Name="BtnNavAbout" Click="SwitchTab_Click" Content="{DynamicResource AboutTab}" Style="{StaticResource TabButton}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Click="MinimizeButton_Click" Content="—" Style="{StaticResource WindowButton}" />
                    <Button Click="MaximizeButton_Click" Content="□" Style="{StaticResource WindowButton}" />
                    <Button Click="CloseButton_Click" Content="×" Style="{StaticResource WindowButton}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="14,0,14,14" Background="{DynamicResource WorkspaceBackground}" CornerRadius="12">
                <ContentControl x:Name="MainContent" Margin="26,24,26,26" />
            </Border>
        </Grid>
    </Border>
</Window>
