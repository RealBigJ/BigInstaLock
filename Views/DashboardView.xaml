<UserControl
    x:Class="Valorant_Instalocker.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:main="clr-namespace:Valorant_Instalocker.Main">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="Manual pick" />

            <Border Grid.Column="1" Padding="4" Background="{DynamicResource ElevatedBackground}" CornerRadius="11">
                <StackPanel Orientation="Horizontal">
                    <Border Padding="15,8" Background="{DynamicResource AccentPrimary}" CornerRadius="8">
                        <TextBlock FontWeight="SemiBold" Foreground="White" Text="Manual" />
                    </Border>
                    <Button x:Name="RulesModeButton" MinHeight="34" Margin="4,0,0,0" Padding="14,7" Click="OpenMapRules_Click" Content="Map rules" Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Margin="0,0,9,0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" Background="{DynamicResource ElevatedBackground}" CornerRadius="15">
                            <Ellipse Width="8" Height="8">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsClientLoggedIn, Source={x:Static main:AppStateManager.Instance}}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentSuccess}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Border>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding CurrentPhaseTranslated, Source={x:Static main:AppStateManager.Instance}}" />
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Width="132" Height="132" HorizontalAlignment="Center" Background="{DynamicResource ElevatedBackground}" BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="1" CornerRadius="26">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Foreground="{DynamicResource TextSecondary}" Text="?" />
                                <Image Margin="7" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding SelectedAgentImage, Source={x:Static main:AppStateManager.Instance}}" />
                            </Grid>
                        </Border>
                        <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding SelectedAgentDisplayName, Source={x:Static main:AppStateManager.Instance}}" />
                        <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalockRunning, Source={x:Static main:AppStateManager.Instance}}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="Text" Value="Armed for next match" /><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsMapRuleActive, Source={x:Static main:AppStateManager.Instance}}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="Text" Value="Map rule applied" /><Setter Property="Foreground" Value="{DynamicResource AccentSuccess}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding ActiveMapName, Source={x:Static main:AppStateManager.Instance}}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMapRuleActive, Source={x:Static main:AppStateManager.Instance}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Button x:Name="CancelInstalockAction" Margin="0,0,0,8" Click="CancelInstalockAction_Click" Content="{DynamicResource CancelBtn}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsInstalockRunning, Source={x:Static main:AppStateManager.Instance}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button x:Name="QuitPreGameAction" Click="QuitPreGameAction_Click" Content="{DynamicResource QuitPreGameBtn}" Style="{StaticResource DangerButton}" Visibility="{Binding QuitPreGameBtnBool, Source={x:Static main:AppStateManager.Instance}, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Choose an agent" />

                    <Grid Grid.Row="1" Margin="-5,13,-5,10">
                        <TextBlock x:Name="AgentsMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Text="Loading agents…" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="AgentsContainer" HorizontalAlignment="Center" />
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <CheckBox x:Name="OnlySelectCheckBox" VerticalAlignment="Center" Checked="OnlySelectCheckBox_Changed" Content="{DynamicResource OnlySelectCheckBox}" Style="{StaticResource ModernCheckBox}" Unchecked="OnlySelectCheckBox_Changed" />
                        <Button x:Name="ActionBtn" Grid.Column="1" MinWidth="175" Click="ActionBtn_Click" Content="Choose an agent" IsEnabled="False" Style="{StaticResource ModernButton}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
