<UserControl
    x:Class="Valorant_Instalocker.Views.MacrosView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid Margin="2,0,2,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="Map rules" />
            <Border Grid.Column="1" Padding="13,9" VerticalAlignment="Center" Background="{DynamicResource ElevatedBackground}" BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="1" CornerRadius="8">
                <CheckBox x:Name="MapRulesEnabledCheckBox" Checked="MapRulesEnabled_Changed" Content="Automation enabled" Style="{StaticResource ModernCheckBox}" Unchecked="MapRulesEnabled_Changed" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Margin="0,0,9,0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="New rule" />

                    <Border Grid.Row="1" Height="118" Margin="0,16,0,18" Background="{DynamicResource ElevatedBackground}" ClipToBounds="True" CornerRadius="8">
                        <Grid>
                            <Image x:Name="MapPreviewImage" Opacity="0.42" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
                            <Rectangle>
                                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#EA12161D" Offset="0" /><GradientStop Color="#6812161D" Offset="0.62" /><GradientStop Color="#1012161D" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                            </Rectangle>
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock x:Name="MapPreviewName" FontSize="21" FontWeight="SemiBold" Foreground="White" Text="Map" />
                                    <TextBlock x:Name="AgentPreviewName" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextMuted}" Text="Agent" />
                                </StackPanel>
                                <Image x:Name="AgentPreviewImage" Grid.Column="1" Margin="0,-8,-8,-12" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Map" />
                            <ComboBox x:Name="MapComboBox" Margin="0,0,0,15" DisplayMemberPath="DisplayName" SelectionChanged="MapComboBox_SelectionChanged" Style="{StaticResource InstalockerComboBoxStyle}" />

                            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Agent" />
                            <ComboBox x:Name="AgentComboBox" Margin="0,0,0,15" SelectionChanged="AgentComboBox_SelectionChanged" Style="{StaticResource InstalockerComboBoxStyle}" />

                            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Action" />
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <RadioButton x:Name="LockModeRadio" Margin="0,0,5,0" GroupName="RuleMode" IsChecked="True" Style="{StaticResource ChoiceRadioButton}"><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Lock instantly" /></RadioButton>
                                <RadioButton x:Name="SelectModeRadio" Grid.Column="1" Margin="5,0,0,0" GroupName="RuleMode" Style="{StaticResource ChoiceRadioButton}"><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Select only" /></RadioButton>
                            </Grid>

                            <Button x:Name="SaveRuleButton" HorizontalAlignment="Stretch" Click="SaveRule_Click" Content="Save rule" Style="{StaticResource ModernButton}" />
                            <Button x:Name="CancelEditButton" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="CancelEdit_Click" Content="Cancel" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" />
                            <TextBlock x:Name="EditorMessage" Margin="0,11,0,0" Foreground="{DynamicResource AccentWarning}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource SurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Saved rules" />
                        <Border Grid.Column="1" Padding="9,5" VerticalAlignment="Center" Background="{DynamicResource ElevatedBackground}" CornerRadius="6"><TextBlock x:Name="RulesCountText" FontSize="10" Foreground="{DynamicResource TextSecondary}" /></Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <StackPanel x:Name="EmptyRulesPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="30" Foreground="{DynamicResource TextSecondary}" Text="＋" />
                            <TextBlock Margin="0,9,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="No saved rules" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RulesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="88" Margin="0,0,5,9" Background="{DynamicResource ElevatedBackground}" BorderBrush="{DynamicResource DefaultBorder}" BorderThickness="1" ClipToBounds="True" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Margin="7" Background="{DynamicResource SurfaceBackground}" CornerRadius="6"><Grid><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource TextSecondary}" Text="?" /><Image Margin="3" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding AgentImage}" Stretch="Uniform" /></Grid></Border>
                                                <StackPanel Grid.Column="1" Margin="13,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding AgentLabel}" />
                                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" Text="{Binding MapName}" />
                                                        <TextBlock Margin="9,0,0,0" FontSize="11" Foreground="{DynamicResource AccentPrimary}" Text="{Binding ModeLabel}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,9,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Button Width="36" Height="36" Margin="0,0,3,0" Click="EditRule_Click" Content="✎" Style="{StaticResource IconButton}" Tag="{Binding}" ToolTip="Edit rule" />
                                                    <Button Width="36" Height="36" Click="DeleteRule_Click" Content="×" Style="{StaticResource IconButton}" Tag="{Binding}" ToolTip="Delete rule" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
